        "structured": {
          "species.shortDescription": "Naturally evolved, furred humanoids whose rabbit-like skull, face, long ears, and powerful jumping anatomy are convergent traits rather than evidence of rabbit ancestry.",
          "species.classification": "Natural sapient humanoid Species; exact formal taxonomy not yet authored",
          "species.speciesType": "Biological Species",
          "species.playable": true,
          "species.variantType": "Base Species",
          "species.biologySummary": "Two-armed, two-legged, plantigrade, furred humanoids with two long auditory/sensory ears, broad ordinary genetic variation in adult frame, specialized spring-leg anatomy, oxygen-breathing endothermic omnivory, approximately 25% faster metabolism than the human comparison baseline, and a voluntary coordinated peak-output capability known as Burst.",
          "species.appearanceSummary": "Rabbit-like skull, nose, face, and long expressive ears; five digits per hand and foot; large plantigrade feet; thick nail-like claws; no tail; human-like external hand arrangement and teeth; wide natural coat colors and patterns; head hair, manes, crests, and thicker fur patches can occur. Vivid unnatural coat colors are cosmetic.",
          "species.typicalSize": "Central approximately 50%: 4 ft 9 in–6 ft 2 in and 90–250 lb",
          "species.cultureSummary": "Akwi cultures are intentionally diverse. Twiloni and Azerkiji are established examples; neither culture nor the broader Akavic identity is inherited biology.",
          "species.societySummary": "Akwi societies vary across a’Wiio and the diaspora. Readiness-based adulthood and a widespread but uneven protective-duty tradition are established social institutions, not biological traits.",
          "species.homeworldObjectID": "world.aiwiio",
          "species.innateAbilities": [
            "feature.akwi.aural-sensory-complex",
            "feature.akwi.spring-leg-anatomy",
            "ability.akwi.burst",
            "trait.akwi.accelerated-metabolism",
            "trait.akwi.expressive-ear-physiology",
            "trait.akwi.furred-body-covering",
            "trait.akwi.high-register-vocal-range",
            "trait.akwi.thick-nail-claws",
            "trait.akwi.body-size-variation"
          ],
          "species.senses": "Ordinary human-comparable channels plus approximately 20% stronger attentive hearing and ear-based magnetoreception, pressure, airflow, tactile, and positional information; no established dimensional-instability sense",
          "species.locomotion": "Normal upright walking plus exceptional vertical and horizontal jumping; swimming, climbing, and burrowing broadly comparable to the supplied human baseline",
          "species.biologicalLimitations": "Lower sustained-exertion profile than the human marathon comparison; Burst produces recovery demand and overuse risk; long ears require equipment accommodation and are exposed sensory structures; hearing requires attention for useful benefit.",
          "species.languageSummary": "Twil is the major travel lingua franca; Kitell is another major a’Wiio language. Many other languages exist. Species selection alone should not yet imply a language grant.",
