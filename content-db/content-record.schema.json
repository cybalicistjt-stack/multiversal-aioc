{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multiversal.local/schemas/content-record.schema.json",
  "title": "Multiversal Content Database Record",
  "type": "object",
  "required": [
    "databaseId",
    "name",
    "objectType",
    "developmentStage",
    "source",
    "provenance"
  ],
  "properties": {
    "databaseId": { "type": "string", "minLength": 1 },
    "stableId": { "type": "string" },
    "name": { "type": "string", "minLength": 1 },
    "objectType": { "type": "string", "minLength": 1 },
    "developmentStage": {
      "enum": [
        "Missing / not converted",
        "Source identified",
        "Conversion queued",
        "Partial conversion",
        "Structured draft",
        "Schema review",
        "Balance review",
        "Testing",
        "Approved",
        "Released",
        "Blocked"
      ]
    },
    "source": { "type": "string", "minLength": 1 },
    "sourceLocator": { "type": "string" },
    "coverageStatus": { "type": "string" },
    "promotionDecision": { "type": "string" },
    "reviewStatus": { "type": "string" },
    "schemaVersion": { "type": "string" },
    "contentVersion": { "type": "string" },
    "packIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "dependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "manualEntry": { "type": ["object", "null"] },
    "gameObject": { "type": ["object", "null"] },
    "validation": { "type": ["object", "null"] },
    "balance": { "type": ["object", "null"] },
    "testing": { "type": ["object", "null"] },
    "provenance": {
      "type": "object",
      "required": ["authority"],
      "properties": {
        "authority": { "type": "string", "minLength": 1 },
        "phaseRange": { "type": "string" },
        "inventoryId": { "type": "string" },
        "sourcePath": { "type": "string" },
        "sourceDigest": { "type": "string" },
        "importedBy": { "type": "string" },
        "importedAt": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
