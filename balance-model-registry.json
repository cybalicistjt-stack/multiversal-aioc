{"registryId":"mv.aioc.balance-model.8d007g","version":"0.1.0","source":"Multiversal_8D-007G_Balance_Metrics_and_Evaluation_Model_v0.1.0","metrics":[{"id":"mv.quality.balance-metric.progression-cost-efficiency","key":"progression-cost-efficiency","name":"Progression Cost Efficiency","category":"progression","engine":"progression_cost_efficiency","formula":"normalizedUtilityGain / (xpCostUnits + prerequisiteCostUnits + opportunityCostUnits)","inputVariables":["normalizedUtilityGain","xpCostUnits","prerequisiteCostUnits","opportunityCostUnits"],"measurementIntent":"Power or utility gain relative to XP, prerequisites, and opportunity cost.","unit":"utility-gain-per-acquisition-cost","riskDirection":"two-sided","aggregation":"mean","requiredEvidenceGrade":"E4","status":"locked-model"},{"id":"mv.quality.balance-metric.damage-reliability","key":"damage-reliability","name":"Damage Reliability and Variance","category":"damage","engine":"damage_reliability","formula":"standardDeviation / abs(meanDamage)","inputVariables":["standardDeviation","meanDamage"],"measurementIntent":"Spread, miss sensitivity, critical sensitivity, and floor/ceiling behavior.","unit":"coefficient-of-variation","riskDirection":"upper","aggregation":"distribution","requiredEvidenceGrade":"E4","status":"locked-model"},{"id":"mv.quality.balance-metric.recovery-efficiency","key":"recovery-efficiency","name":"Recovery Efficiency","category":"recovery","engine":"recovery_efficiency","formula":"restoredEffectiveVitality / (recoveryCapacityUnits + timeOpportunityUnits)","inputVariables":["restoredEffectiveVitality","recoveryCapacityUnits","timeOpportunityUnits"],"measurementIntent":"Health, condition, and resource recovery per rest, time, or capacity.","unit":"restored-vitality-per-recovery-cost","riskDirection":"upper","aggregation":"mean","requiredEvidenceGrade":"E4","status":"locked-model"},{"id":"mv.quality.balance-metric.upgrade-marginal-value","key":"upgrade-marginal-value","name":"Upgrade Marginal Value","category":"progression","engine":"upgrade_marginal_value","formula":"(upgradedUtility - baseUtility) / abs(baseUtility)","inputVariables":["upgradedUtility","baseUtility"],"measurementIntent":"Incremental value of an upgrade relative to base ability and alternatives.","unit":"relative-utility-change","riskDirection":"two-sided","aggregation":"mean","requiredEvidenceGrade":"E4","status":"locked-model"},{"id":"mv.quality.balance-metric.counterplay-access","key":"counterplay-access","name":"Counterplay Availability","category":"fairness","engine":"counterplay_access","formula":"effectiveCounterWeight / requiredCounterWeight","inputVariables":["effectiveCounterWeight","requiredCounterWeight"],"measurementIntent":"Availability, cost, timing, and clarity of effective counterplay.","unit":"effective-counter-coverage-ratio","riskDirection":"lower","aggregation":"proportion","requiredEvidenceGrade":"E4","status":"locked-model"},{"id":"mv.quality.balance-metric.survivability","key":"survivability","name":"Survivability","category":"defense","engine":"survivability","formula":"effectivePressureAbsorbed / pressurePerRound","inputVariables":["effectivePressureAbsorbed","pressurePerRound"],"measurementIntent":"Rounds, hits, or expected pressure survived under declared profiles.","unit":"expected-pressure-rounds-survived","riskDirection":"upper","aggregation":"mean","requiredEvidenceGrade":"E4","status":"locked-model"},{"id":"mv.quality.balance-metric.creature-challenge-range","key":"creature-challenge-range","name":"Creature Challenge Range","category":"creatures","engine":"creature_challenge_range","formula":"targetBandSuccessCount / testedProfileCount","inputVariables":["targetBandSuccessCount","testedProfileCount"],"measurementIntent":"Observed challenge distribution across parties, profiles, and environments.","unit":"target-band-coverage-ratio","riskDirection":"lower","aggregation":"proportion","requiredEvidenceGrade":"E4","status":"locked-model"},{"id":"mv.quality.balance-metric.economy-price-pressure","key":"economy-price-pressure","name":"Economy and Price Pressure","category":"economy","engine":"economy_price_pressure","formula":"(resaleValue + craftedOutputValue - consumableCost - inputCost) / initialInvestment","inputVariables":["resaleValue","craftedOutputValue","consumableCost","inputCost","initialInvestment"],"measurementIntent":"Price, availability, crafting, and resale interactions that create runaway value.","unit":"net-value-gain-ratio","riskDirection":"upper","aggregation":"mean","requiredEvidenceGrade":"E4","status":"locked-model"},{"id":"mv.quality.balance-metric.equipment-dominance","key":"equipment-dominance","name":"Equipment Dominance","category":"items","engine":"equipment_dominance","formula":"maximumPairwiseAdvantage * selectionShare","inputVariables":["maximumPairwiseAdvantage","selectionShare"],"measurementIntent":"Frequency and magnitude by which one item eclipses comparable alternatives.","unit":"dominance-index","riskDirection":"upper","aggregation":"distribution","requiredEvidenceGrade":"E4","status":"locked-model"},{"id":"mv.quality.balance-metric.expected-damage-output","key":"expected-damage-output","name":"Expected Damage Output","category":"damage","engine":"expected_damage_output","formula":"expectedDamage / opportunityUnits","inputVariables":["expectedDamage","opportunityUnits"],"measurementIntent":"Expected damage per successful use and per round.","unit":"expected-damage-per-opportunity","riskDirection":"upper","aggregation":"mean","requiredEvidenceGrade":"E4","status":"locked-model"},{"id":"mv.quality.balance-metric.resource-efficiency","key":"resource-efficiency","name":"Resource Efficiency","category":"resources","engine":"resource_efficiency","formula":"benefitUnits / resourceUnitsConsumed","inputVariables":["benefitUnits","resourceUnitsConsumed"],"measurementIntent":"Benefit delivered per reserved or consumed resource unit.","unit":"benefit-units-per-resource-unit","riskDirection":"upper","aggregation":"mean","requiredEvidenceGrade":"E4","status":"locked-model"},{"id":"mv.quality.balance-metric.asset-operating-efficiency","key":"asset-operating-efficiency","name":"Asset Operating Efficiency","category":"assets","engine":"asset_operating_efficiency","formula":"outputUnits / (crewCostUnits + fuelCostUnits + heatCostUnits + maintenanceCostUnits + deploymentCostUnits)","inputVariables":["outputUnits","crewCostUnits","fuelCostUnits","heatCostUnits","maintenanceCostUnits","deploymentCostUnits"],"measurementIntent":"Output relative to crew, fuel, heat, maintenance, and deployment costs.","unit":"output-units-per-operating-cost","riskDirection":"two-sided","aggregation":"mean","requiredEvidenceGrade":"E4","status":"locked-model"},{"id":"mv.quality.balance-metric.threat-reward","key":"threat-reward","name":"Threat-to-Reward Relationship","category":"encounters","engine":"threat_reward","formula":"rewardUnits / threatCostUnits","inputVariables":["rewardUnits","threatCostUnits"],"measurementIntent":"Reward, XP, or narrative value relative to measured threat and cost.","unit":"reward-units-per-threat-cost","riskDirection":"two-sided","aggregation":"mean","requiredEvidenceGrade":"E4","status":"locked-model"},{"id":"mv.quality.balance-metric.condition-control-burden","key":"condition-control-burden","name":"Condition and Control Burden","category":"control","engine":"condition_control_burden","formula":"deniedActionUnits + movementLossUnits + recoveryActionUnits + forcedResourceUnits","inputVariables":["deniedActionUnits","movementLossUnits","recoveryActionUnits","forcedResourceUnits"],"measurementIntent":"Expected lost actions, movement, agency, or recovery effort.","unit":"denied-action-equivalent-units","riskDirection":"upper","aggregation":"mean","requiredEvidenceGrade":"E4","status":"locked-model"},{"id":"mv.quality.balance-metric.encounter-duration","key":"encounter-duration","name":"Encounter Duration","category":"encounters","engine":"encounter_duration","formula":"totalRounds / resolvedEncounterCount","inputVariables":["totalRounds","resolvedEncounterCount"],"measurementIntent":"Expected rounds and variance to resolution under declared assumptions.","unit":"rounds-to-resolution","riskDirection":"target-band","aggregation":"mean","requiredEvidenceGrade":"E4","status":"locked-model"},{"id":"mv.quality.balance-metric.action-economy-efficiency","key":"action-economy-efficiency","name":"Action Economy Efficiency","category":"action-economy","engine":"action_economy_efficiency","formula":"benefitUnits / actionEquivalentCost","inputVariables":["benefitUnits","actionEquivalentCost"],"measurementIntent":"Benefit delivered per action, reaction, move, or approval opportunity.","unit":"benefit-units-per-action-equivalent","riskDirection":"upper","aggregation":"mean","requiredEvidenceGrade":"E4","status":"locked-model"},{"id":"mv.quality.balance-metric.build-variance-diversity","key":"build-variance-diversity","name":"Build Variance and Diversity","category":"builds","engine":"build_variance_diversity","formula":"1 - sum(selectionShare_i ^ 2)","inputVariables":["selectionShares"],"measurementIntent":"Performance spread and dominance across viable build choices.","unit":"one-minus-herfindahl-index","riskDirection":"lower","aggregation":"distribution","requiredEvidenceGrade":"E4","status":"locked-model"}]}