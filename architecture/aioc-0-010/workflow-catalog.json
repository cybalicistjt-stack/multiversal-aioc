    {"id":"WF-AI-001","name":"Answer an evidence-backed project question","steps":["resolve workspace","classify intent","plan context","retrieve evidence","check conflicts","answer with evidence"]},
    {"id":"WF-AI-002","name":"Propose a repository change","steps":["resolve repository and branch","retrieve state","draft typed proposal","classify risk","route approval","execute tool","verify result","record evidence"]},
    {"id":"WF-AI-003","name":"Handle ambiguous command","steps":["identify ambiguity","use context to resolve","present bounded interpretation when material","avoid execution until resolved"]},
    {"id":"WF-AI-004","name":"Generate a recommendation","steps":["define objective","gather constraints","retrieve evidence","rank options","expose tradeoffs","assign decision owner"]},
    {"id":"WF-AI-005","name":"Resolve contradictory sources","steps":["identify claims","compare authority and version","preserve both records","propose resolution","record decision"]},
    {"id":"WF-AI-006","name":"Create durable memory","steps":["extract candidate","verify source","define scope and retention","request required approval","write memory record","link supersession"]},
    {"id":"WF-AI-007","name":"Prepare a GM session","steps":["resolve campaign","filter visibility","retrieve active threads","assemble scenes and actors","identify risks","produce GM brief"]},
    {"id":"WF-AI-008","name":"Assist a live GM action","steps":["receive action","identify actor and targets","retrieve rule evidence","calculate proposed result","show modifiers","request GM disposition","record final event"]},
    {"id":"WF-AI-009","name":"Track investigation intelligence","steps":["retrieve clues","separate known and hidden facts","map hypotheses","flag contradictions","recommend next reveals"]},
    {"id":"WF-AI-010","name":"Delegate to specialist agents","steps":["split bounded tasks","create delegation packets","run specialists","review conflicts","validate outputs","assemble result"]},
    {"id":"WF-AI-011","name":"Recover after tool failure","steps":["stop writes","inspect partial effects","recheck permissions","restore current state","retry only when safe","record incident"]},
    {"id":"WF-AI-012","name":"Operate with degraded connectivity","steps":["load verified local context","mark freshness limits","restrict unsafe commands","queue eligible proposals","reconcile after reconnect"]},
