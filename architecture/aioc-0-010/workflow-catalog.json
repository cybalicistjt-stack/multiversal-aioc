    {"id":"WF-AI-014","name":"Evaluate assistant quality","steps":["select corpus","run scenarios","score grounding and policy","review failures","publish findings"]},
    {"id":"WF-AI-015","name":"Correct a false prior claim","steps":["identify unsupported claim","inspect actual state","correct record","assess downstream effects","resume from verified state"]},
    {"id":"WF-AI-016","name":"Cross-repository operation","steps":["resolve project domain","name repository explicitly","validate permissions","isolate branch","execute governed change","verify correct target"]}
  ]
