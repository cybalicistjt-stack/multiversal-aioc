    {
      "candidateId": "mv.item.rarity-tiers.8c8fc823",
      "proposedType": "item",
      "proposedName": "Rarity Tiers",
      "summary": "•Common (1): Easily found, but often in poor condition or with minimal benefits. Serve as baseline components or crafting materials. •Uncommon (2): Slightly rarer, offering better quality items. Usable with moderate repair or enhancement. •Rare (3): Items with distinct qualities but some drawbacks. Repairing or using them may require specialized skills or resources. •Epic (4): Highly sought-after components with significant advantages, despite some issues. Repair or enhancement is challenging but rewarding. •Legendary (5): Extremely rare, top-tier components. Possessing these often provides substantial bonuses or unique abilities.",
      "source": {
        "sourcePath": "part-3/Part 3/Rules/Looting_Salvaging_Scavenging.PDF",
        "pageStart": 4,
        "pageEnd": 4,
        "locator": "page:4;chunk:1",
