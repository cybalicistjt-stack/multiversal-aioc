{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multiversal.invalid/schemas/semantic-foundry/recovery-candidate-envelope-v1.json",
  "title": "Multiversal Recovery Candidate Envelope",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "type", "name", "lifecycleStatus", "specification", "provenance", "validation", "reviewRoute"],
  "properties": {
    "id": {"type": "string", "minLength": 3},
    "type": {"enum": ["rule", "ability", "creature", "item", "species", "npc", "vehicle", "environment", "world", "faction", "adventure"]},
    "name": {"type": "string", "minLength": 1},
    "lifecycleStatus": {"const": "candidate"},
    "specification": {"type": "object"},
    "relationships": {"type": "array"},
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sourcePath", "locator"],
        "properties": {
          "sourcePath": {"type": "string", "minLength": 1},
          "locator": {"type": ["string", "null"]},
          "pageStart": {"type": ["integer", "null"], "minimum": 0},
          "pageEnd": {"type": ["integer", "null"], "minimum": 0},
          "contentHash": {"type": ["string", "null"]}
        }
      }
    },
    "validation": {"type": "object"},
    "reviewRoute": {"enum": ["expert-sample", "human-review", "evidence-only"]}
  }
}
