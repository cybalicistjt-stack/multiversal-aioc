{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multiversal.local/schemas/semantic-ontology.schema.json",
  "title": "Multiversal AIOC Semantic Ontology and Knowledge Graph",
  "type": "object",
  "required": ["format", "version", "generatedAt", "policy", "summary", "concepts", "entities", "assertions", "unresolved"],
  "properties": {
    "format": { "const": "multiversal-aioc-semantic-ontology" },
    "version": { "const": "1.0.0" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "policy": { "type": "object" },
    "summary": { "type": "object" },
    "concepts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["conceptId", "kind", "key", "label", "authority", "evidence"],
        "properties": {
          "conceptId": { "type": "string", "pattern": "^CONCEPT-" },
          "kind": { "enum": ["object-type", "authority-layer", "lifecycle", "pack", "relationship"] },
          "key": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "authority": { "const": "derived" },
          "evidence": { "type": "array", "minItems": 1 }
        },
        "additionalProperties": true
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entityId", "stableId", "name", "authorityLayer", "lifecycle", "evidence"],
        "properties": {
          "entityId": { "type": "string", "pattern": "^ENTITY-" },
          "stableId": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "authorityLayer": { "type": "string", "minLength": 1 },
          "lifecycle": { "type": "string", "minLength": 1 },
          "evidence": { "type": "array", "minItems": 1 }
        },
        "additionalProperties": true
      }
    },
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["assertionId", "subject", "predicate", "object", "confidence", "inferenceMethod", "evidence", "advisory"],
        "properties": {
          "assertionId": { "type": "string", "pattern": "^ASSERT-" },
          "subject": { "type": "string", "minLength": 1 },
          "predicate": { "type": "string", "minLength": 1 },
          "object": { "type": "string", "minLength": 1 },
          "confidence": { "enum": ["explicit", "high", "medium", "low"] },
          "inferenceMethod": { "enum": ["field-mapping", "graph-projection"] },
          "evidence": { "type": "array", "minItems": 1 },
          "advisory": { "const": true }
        },
        "additionalProperties": true
      }
    },
    "unresolved": { "type": "array" }
  },
  "additionalProperties": true
}
