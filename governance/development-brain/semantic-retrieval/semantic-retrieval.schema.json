{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multiversal.local/schemas/semantic-retrieval.schema.json",
  "title": "Multiversal AIOC Semantic Retrieval and Reasoning Context",
  "type": "object",
  "required": ["format", "version", "generatedAt", "policy", "summary", "packages", "diagnostics"],
  "properties": {
    "format": { "const": "multiversal-aioc-semantic-retrieval" },
    "version": { "const": "1.0.0" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "policy": { "type": "object" },
    "summary": { "type": "object" },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["packageId", "subject", "budget", "freshness", "items", "authority", "advisory"],
        "properties": {
          "packageId": { "type": "string", "pattern": "^CONTEXT-" },
          "subject": { "type": "string", "pattern": "^ENTITY-" },
          "budget": {
            "type": "object",
            "required": ["maxItems", "maxCharacters", "usedItems", "usedCharacters"],
            "properties": {
              "maxItems": { "type": "integer", "minimum": 1 },
              "maxCharacters": { "type": "integer", "minimum": 1 },
              "usedItems": { "type": "integer", "minimum": 0 },
              "usedCharacters": { "type": "integer", "minimum": 0 }
            }
          },
          "freshness": { "type": "object", "required": ["status", "sourceFingerprint"] },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["contextItemId", "category", "rank", "score", "statement", "authorityLayer", "confidence", "sourceEvidence", "freshness", "advisory"],
              "properties": {
                "contextItemId": { "type": "string", "pattern": "^CTXITEM-" },
                "category": { "enum": ["source-fact", "derived-finding", "recommendation", "constraint", "unresolved-question"] },
                "rank": { "type": "integer", "minimum": 1 },
                "score": { "type": "number", "minimum": 0, "maximum": 100 },
                "statement": { "type": "string", "minLength": 1 },
                "authorityLayer": { "type": "string", "minLength": 1 },
                "confidence": { "enum": ["explicit", "high", "medium", "low", "unknown"] },
                "sourceEvidence": { "type": "array", "minItems": 1 },
                "freshness": { "enum": ["current", "stale", "unknown"] },
                "advisory": { "const": true }
              },
              "additionalProperties": true
            }
          },
          "authority": { "const": "read-only-context" },
          "advisory": { "const": true }
        },
        "additionalProperties": true
      }
    },
    "diagnostics": { "type": "object" }
  },
  "additionalProperties": true
}
