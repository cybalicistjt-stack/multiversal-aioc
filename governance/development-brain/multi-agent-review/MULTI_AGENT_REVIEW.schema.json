{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multiversal.invalid/schemas/multi-agent-review.schema.json",
  "title": "Multiversal AIOC Multi-Agent Review and Synthesis",
  "type": "object",
  "required": ["format", "version", "generatedAt", "sourceFingerprint", "panels", "diagnostics", "authority"],
  "properties": {
    "format": {"const": "multiversal-aioc-multi-agent-review"},
    "version": {"type": "string"},
    "generatedAt": {"type": "string"},
    "sourceFingerprint": {"type": "string", "minLength": 16},
    "panels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["panelId", "taskId", "reviewerRoleIds", "contributions", "outcome", "synthesis", "evidence", "authorityMode", "unresolvedQuestions"],
        "properties": {
          "panelId": {"type": "string"},
          "taskId": {"type": "string"},
          "reviewerRoleIds": {"type": "array", "minItems": 2, "items": {"type": "string"}},
          "contributions": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["contributionId", "roleId", "position", "confidence", "evidence", "constraints", "unresolvedQuestions"], "properties": {
            "contributionId": {"type": "string"}, "roleId": {"type": "string"}, "position": {"type": "string"}, "confidence": {"enum": ["low", "medium", "high"]}, "evidence": {"type": "array", "minItems": 1}, "constraints": {"type": "array"}, "unresolvedQuestions": {"type": "array"}
          }},
          "outcome": {"enum": ["consensus", "supported-disagreement", "unresolved-conflict", "minority-finding", "blocked-review", "owner-decision-required"]},
          "synthesis": {"type": "string"},
          "minorityPositions": {"type": "array"},
          "evidence": {"type": "array", "minItems": 1},
          "authorityMode": {"enum": ["read-only", "advisory", "proposal-only"]},
          "unresolvedQuestions": {"type": "array"}
        }
      }
    },
    "diagnostics": {"type": "object"},
    "authority": {"type": "object", "required": ["advisoryOnly", "canonicalMutationAllowed", "approvalGranted", "certificationAllowed"]}
  }
}
