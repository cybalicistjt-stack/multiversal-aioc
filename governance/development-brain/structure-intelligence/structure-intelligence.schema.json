{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multiversal.example/governance/development-brain/structure-intelligence.schema.json",
  "title": "Multiversal AIOC Structure Intelligence",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "generatedAt", "sources", "summary", "objects", "diagnostics"],
  "properties": {
    "format": { "const": "multiversal-aioc-structure-intelligence" },
    "version": { "const": "1.0.0" },
    "generatedAt": { "type": "string" },
    "sources": { "type": "object" },
    "summary": {
      "type": "object",
      "required": ["totalObjects", "classifiedObjects", "unresolvedClassifications", "orphans", "structuralGaps", "conflicts", "highImpactDependencies"],
      "properties": {
        "totalObjects": { "type": "integer", "minimum": 0 },
        "classifiedObjects": { "type": "integer", "minimum": 0 },
        "unresolvedClassifications": { "type": "integer", "minimum": 0 },
        "orphans": { "type": "integer", "minimum": 0 },
        "structuralGaps": { "type": "integer", "minimum": 0 },
        "conflicts": { "type": "integer", "minimum": 0 },
        "highImpactDependencies": { "type": "integer", "minimum": 0 }
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stableId", "nodeId", "name", "objectType", "authorityLayer", "classification", "parents", "children", "variants", "packs", "structuralDependencies", "issues", "evidence"],
        "properties": {
          "stableId": { "type": "string" },
          "nodeId": { "type": "string" },
          "name": { "type": "string" },
          "objectType": { "type": "string" },
          "authorityLayer": { "enum": ["canonical", "working"] },
          "classification": { "type": ["string", "null"] },
          "parents": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "children": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "variants": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "packs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "structuralDependencies": { "type": "array" },
          "issues": { "type": "array" },
          "evidence": { "type": "array", "minItems": 1 }
        }
      }
    },
    "diagnostics": {
      "type": "object",
      "required": ["unresolvedClassifications", "orphans", "structuralGaps", "conflicts", "highImpactDependencies"],
      "properties": {
        "unresolvedClassifications": { "type": "array" },
        "orphans": { "type": "array" },
        "structuralGaps": { "type": "array" },
        "conflicts": { "type": "array" },
        "highImpactDependencies": { "type": "array" }
      }
    }
  }
}
