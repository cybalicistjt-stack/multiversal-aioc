{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multiversal.local/schemas/verification-governance.schema.json",
  "title": "Multiversal AIOC Verification and Governance Integration",
  "type": "object",
  "required": ["format", "version", "generatedAt", "policy", "summary", "verifications"],
  "properties": {
    "format": { "const": "multiversal-aioc-verification-governance" },
    "version": { "const": "1.0.0" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "policy": { "type": "object" },
    "summary": { "type": "object", "required": ["total", "verifiedExecutable", "requiresApproval", "blocked", "observationOnly"] },
    "verifications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["verificationId", "recommendationId", "stableId", "status", "checks", "approval", "evidence", "advisory"],
        "properties": {
          "verificationId": { "type": "string", "pattern": "^VERIFY-" },
          "recommendationId": { "type": "string", "pattern": "^REC-" },
          "stableId": { "type": "string", "minLength": 1 },
          "status": { "enum": ["verified-executable", "requires-approval", "blocked", "observation-only"] },
          "checks": { "type": "array", "minItems": 1 },
          "approval": { "type": "object" },
          "evidence": { "type": "array", "minItems": 1 },
          "advisory": { "const": true }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
