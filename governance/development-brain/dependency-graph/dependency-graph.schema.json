{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multiversal.example/governance/development-brain/dependency-graph.schema.json",
  "title": "Multiversal AIOC Dependency Graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "generatedAt", "sources", "relationshipVocabulary", "summary", "nodes", "edges", "diagnostics"],
  "properties": {
    "format": { "const": "multiversal-aioc-dependency-graph" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "sources": { "type": "object" },
    "relationshipVocabulary": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["requires", "grants", "contains", "parent-of", "variant-of", "validates", "affects", "supersedes", "blocks", "member-of-pack"] }
    },
    "summary": {
      "type": "object",
      "required": ["totalNodes", "totalEdges", "edgesByType", "danglingTargets", "duplicateEdges", "selfDependencies", "prohibitedCycles"],
      "properties": {
        "totalNodes": { "type": "integer", "minimum": 0 },
        "totalEdges": { "type": "integer", "minimum": 0 },
        "edgesByType": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "danglingTargets": { "type": "integer", "minimum": 0 },
        "duplicateEdges": { "type": "integer", "minimum": 0 },
        "selfDependencies": { "type": "integer", "minimum": 0 },
        "prohibitedCycles": { "type": "integer", "minimum": 0 }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["nodeId", "inventoryId", "stableId", "name", "objectType", "authorityLayer", "lifecycle"],
        "properties": {
          "nodeId": { "type": "string", "pattern": "^NODE-" },
          "inventoryId": { "type": "string" },
          "stableId": { "type": "string" },
          "name": { "type": "string" },
          "objectType": { "type": "string" },
          "authorityLayer": { "type": "string" },
          "lifecycle": { "type": "string" }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["edgeId", "source", "target", "relationship", "confidence", "evidence"],
        "properties": {
          "edgeId": { "type": "string", "pattern": "^EDGE-" },
          "source": { "type": "string" },
          "target": { "type": "string" },
          "relationship": { "$ref": "#/$defs/relationship" },
          "confidence": { "enum": ["explicit", "high", "medium", "low"] },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["sourcePath", "pointer", "derivation"],
              "properties": {
                "sourcePath": { "type": "string" },
                "pointer": { "type": "string" },
                "derivation": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "diagnostics": {
      "type": "object",
      "required": ["danglingTargets", "duplicateEdges", "selfDependencies", "prohibitedCycles"],
      "properties": {
        "danglingTargets": { "type": "array" },
        "duplicateEdges": { "type": "array" },
        "selfDependencies": { "type": "array" },
        "prohibitedCycles": { "type": "array" }
      }
    }
  },
  "$defs": {
    "relationship": { "enum": ["requires", "grants", "contains", "parent-of", "variant-of", "validates", "affects", "supersedes", "blocks", "member-of-pack"] }
  }
}
