  "feature_instance_template": {
    "template_id": "CAS-FEATURE-TEMPLATE-001",
    "purpose": "Reusable topology-gated feature instance for nonhuman and optional structural features.",
    "eligible_feature_kinds": [
      "muzzle",
      "snout",
      "beak",
      "horn",
      "antler",
      "tusk",
      "mandible",
      "antenna",
      "crest",
      "sensory_appendage",
      "tail",
      "wing",
      "fin",
      "gill",
      "claw",
      "talon",
      "stinger",
      "abdomen",
      "whisker_set",
      "plant_growth",
      "modular_part"
    ],
    "fields": [
      {
        "id": "feature.family",
        "kind": "enum_ref",
        "required": true
      },
      {
        "id": "feature.size",
        "kind": "ordinal7",
        "required": false
      },
      {
        "id": "feature.length",
        "kind": "ordinal7",
        "required": false
      },
      {
        "id": "feature.width",
        "kind": "ordinal5",
        "required": false
      },
      {
        "id": "feature.curvature",
        "kind": "ordinal5",
        "required": false
      },
      {
        "id": "feature.angle",
        "kind": "ordinal5",
        "required": false
      },
      {
        "id": "feature.spread",
        "kind": "ordinal5",
        "required": false
      },
      {
        "id": "feature.orientation_profile",
        "kind": "enum_ref",
        "required": false
      },
      {
        "id": "feature.palette_zone_ref",
        "kind": "enum_ref",
        "required": false
      },
      {
        "id": "feature.pattern_ref",
        "kind": "enum_ref",
        "required": false
      },
      {
        "id": "feature.presentation_pose_ref",
        "kind": "profile_ref",
        "required": false
      }
    ],
    "rules": [
      "Feature kind and cardinality come from Species/Form/PPIA authority or an authorized optional appearance choice.",
      "Fields are exposed only when the feature template declares them meaningful.",
      "A photo/reference matcher may propose dimensions or family only after topology eligibility is known.",
      "Feature instances never create anatomy, mechanics, flight, reach, attacks or equipment ownership.",
      "Unsupported asset coverage preserves semantic state and reports partial/unsupported rendering."
    ]
  },
  "profile_eligibility": {
    "source": "CAPP-01 + PPIA-05/PPIA-06 + current Species/Form/profile authority",
    "rule": "The parameter registry is a vocabulary, not a promise that every parameter exists for every character.",
    "no_humanoid_fallback": true,
    "unavailable_controls": "Omit or explicitly disable with reason; never synthesize human equivalents.",
    "required_features": "Source-owned required anatomy remains required/read-only or source-bounded as specified by the owning profile."
  },
  "image_reference_matching": {
    "role": "proposal_adapter_only",
    "pipeline": [
      "ingest authorized reference",
      "detect/measure visible geometry and silhouette",
      "classify supported feature families",
      "quantize measurements into CAS ordinal/enum values",
      "apply Species/Form/CAPP eligibility and constraints",
      "produce ranked candidate values with confidence and unresolved fields",
      "user reviews/edits",
      "ordinary CAS draft validation and explicit commit"
    ],
    "forbidden": [
      "changing species/topology truth from a photograph",
      "inferring actual equipment ownership",
      "inferring mechanics",
      "committing without user acceptance",
      "baking the imported image as appearance truth",
      "requiring generative image synthesis"
    ]
  },
  "integration_gaps": [
    {
      "id": "CAS-GAP-001",
      "area": "MCCS-05 detailed head/face scalar transport",
      "finding": "MCCS-05 currently models head anchors, feature kind/count and expression structures but does not carry a generic stable parameter/value map for face-shape modifiers.",
      "required_follow_on": "Add a bounded renderer-neutral feature-parameter transport/adapter without transferring appearance authority away from CAPP."
    },
    {
      "id": "CAS-GAP-002",
      "area": "CAPP compiler parameter resolution",
      "finding": "CAPP-05 currently compiles semantic_choice_ids and asset layers but does not explicitly resolve the CAS-PARAM-1 paths/ordinal buckets.",
      "required_follow_on": "Define CAS parameter state input and deterministic parameter-to-asset/variant/palette resolution."
    },
    {
      "id": "CAS-GAP-003",
      "area": "CAS-SD1 density metadata",
      "finding": "Historical CAPP canvas contracts predate the logical-pixel/native-vs-output distinction.",
      "required_follow_on": "Update CAPP/PAPT metadata adapters to reference CAS-SD1 logical profiles without rewriting historical provenance."
    },
    {
      "id": "CAS-GAP-004",
      "area": "PAPT asset coverage",
      "finding": "The new finite parameter vocabulary requires reusable family/variant assets and coverage declarations.",
      "required_follow_on": "Generate a PAPT asset demand ledger from eligible parameter families and golden species/profile cases."
    },
    {
      "id": "CAS-GAP-005",
      "area": "Fashion parameter grammar",
      "finding": "CAS-WARD-001 intentionally references governed outfits but does not yet define garment construction primitives.",
      "required_follow_on": "Create separate Fashion/Garment Parameter Authority using CAS-SD1 and CAPP-06 fit semantics."
    }
  ],
  "boundaries": {
    "runtime_activation": false,
    "application_code_change": false,
    "mechanics_mutation": false,
    "biology_mutation": false,
    "equipment_ownership_mutation": false,
    "public_marketplace_authorization": false,
    "generative_ai_required": false
  }
}
