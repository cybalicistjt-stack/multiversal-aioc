{
  "schema_version": "1.0.0",
  "document_id": "MV-CAS-PARAM-AUTH-001",
  "authority_id": "CAS-PARAM-1",
  "status": "canonical_design_authority",
  "effective_date": "2026-10-03",
  "owner_final_authority": "John Brandon Turner",
  "purpose": "Define the finite renderer-neutral Character Appearance Studio parameter vocabulary that CAPP compiles, MCCS hosts as a creator workspace, and PAPT supplies with governed reusable pixel assets.",
  "supersedes_or_extends": {
    "extends": [
      "CAS-SD1_PIXEL_DENSITY_AND_DETAIL_STANDARD_v1.0.0",
      "CAPP-01_APPEARANCE_CHOICE_REGISTRY_v0.1.0",
      "PPIA-06_APPEARANCE_SEMANTIC_TAXONOMY_v0.2.0",
      "PPIA-06_APPEARANCE_STUDIO_CONTROL_SURFACE_v0.1.0"
    ],
    "does_not_replace": [
      "Species/Form/PPIA biology and topology authority",
      "Character identity/mechanics authority",
      "Inventory/Asset/Equipment authority",
      "CAPP renderer-neutral appearance authority",
      "MCCS generalized creator-workspace contracts",
      "PAPT/PCA production primitives"
    ]
  },
  "architecture": {
    "cas_role": "Player-facing and character-facing constrained appearance authoring profile over the generalized MCCS workspace.",
    "mccs_role": "Generalized topology-first character/creature draft workspace, validation/orchestration and derivative authoring substrate.",
    "capp_role": "Renderer-neutral appearance authority, semantic constraint/eligibility owner and deterministic appearance compiler.",
    "papt_role": "Governed reusable pixel-asset/component production, palette/style tooling, fit/anchor/occlusion QA and derivative factory.",
    "cas_sd1_role": "Shared pixel density/detail/rendering standard across CAS, CAPP and PAPT.",
    "rule": "CAS is not a second engine beside MCCS; CAS is the bounded product profile and parameter language used through MCCS while CAPP remains appearance authority."
  },
  "audit_baseline": {
    "capp_profiles": 25,
    "capp_choice_surfaces": 10,
    "capp_required_feature_contracts": 74,
    "capp_bounded_choice_contracts": 78,
    "capp_explicit_choice_contracts": 28,
    "finding": "Existing CAPP/PPIA strongly defines authority, species constraints, topology and surface categories but does not yet provide a sufficiently concrete cross-species fine-grained CAS parameter vocabulary.",
    "mccs_finding": "Current MCCS contracts provide generic numeric morphology/silhouette channels, topology/head feature structures, surface refs, wardrobe composition, pose, derivative, style, form and interchange contracts. They intentionally do not define the concrete CAS parameter vocabulary."
  },
  "control_scales": {
    "ordinal5": {
      "storage": "integer",
      "values": [
        -2,
        -1,
        0,
        1,
        2
      ],
      "neutral": 0,
      "ui_rule": "Labels are semantic/profile-specific; raw integers need not be shown."
    },
    "ordinal7": {
      "storage": "integer",
      "values": [
        -3,
        -2,
        -1,
        0,
        1,
        2,
        3
      ],
      "neutral": 0,
      "ui_rule": "Primary bounded scalar for visually meaningful CAS-SD1 proportion changes."
    },
    "enum_ref": {
      "storage": "stable_id",
      "rule": "Value must resolve through the eligible profile/family registry."
    },
    "palette_zone_set_ref": {
      "storage": "stable_id",
      "rule": "Resolves semantic palette zones and controlled ramps; color alone is never the only semantic carrier."
    },
    "layer_set_ref": {
      "storage": "stable_id_array",
      "rule": "Ordered, provenance-bearing layer references."
    },
    "profile_ref": {
      "storage": "stable_id",
      "rule": "Reference to governed pose/expression/age/outfit/etc profile."
    }
  },
  "scalar_rules": [
    "CAS does not expose unconstrained floating-point sliders as canonical semantic state.",
    "Existing MCCS numeric channels receive normalized values through an adapter derived from the canonical ordinal bucket.",
    "A renderer may map the same semantic bucket to topology-specific assets/geometry while preserving the semantic value.",
    "If two adjacent values cannot produce a meaningful CAS-SD1 distinction in any authorized view, the control must be collapsed rather than retaining false precision.",
    "Microdetail that exists only below CAS-SD1 readability is not a primary CAS parameter."
  ],
