  "generic_rules": [
    {
      "rule_id": "CAPP01-GEN-001",
      "type": "permission_first",
      "effect": "Filter hidden biology/current Form/history/equipment before choices, counts, diagnostics, renderer derivation, export or AI context."
    },
    {
      "rule_id": "CAPP01-GEN-002",
      "type": "unknown_preservation",
      "effect": "Unknown/source-unspecified anatomy remains unknown; no human/humanoid default is synthesized."
    },
    {
      "rule_id": "CAPP01-GEN-003",
      "type": "upstream_read_only",
      "effect": "Current Form and persistent/active biological states are upstream projections and cannot be cosmetically rewritten."
    },
    {
      "rule_id": "CAPP01-GEN-004",
      "type": "topology_required",
      "effect": "Required morphology graph nodes/cardinality must exist before topology-dependent authored choices or fit are eligible."
    },
    {
      "rule_id": "CAPP01-GEN-005",
      "type": "renderer_independence",
      "effect": "Renderer supported/partial/unsupported/unknown never changes biological or identity validity."
    },
    {
      "rule_id": "CAPP01-GEN-006",
      "type": "wardrobe_nonmechanical",
      "effect": "Presentation wardrobe is nonmechanical and never implies inventory/equipment ownership."
    },
    {
      "rule_id": "CAPP01-GEN-007",
      "type": "equipment_projection_read_only",
      "effect": "Actual equipment preview is permission-safe PPIA-03 projection and never mutates Asset state."
    },
    {
      "rule_id": "CAPP01-GEN-008",
      "type": "randomization_scope",
      "effect": "Randomization may change only eligible authored/cosmetic choices, never source-owned biology/history/current Form/equipment."
    },
    {
      "rule_id": "CAPP01-GEN-009",
      "type": "no_silent_substitution",
      "effect": "If a committed choice becomes incompatible, return explicit review/diagnostic state; do not replace it silently."
    },
    {
      "rule_id": "CAPP01-GEN-010",
      "type": "ambiguous_mutation_recovery",
      "effect": "On ambiguous mutation result, inspect authoritative operation/current state before retry."
    }
  ],
