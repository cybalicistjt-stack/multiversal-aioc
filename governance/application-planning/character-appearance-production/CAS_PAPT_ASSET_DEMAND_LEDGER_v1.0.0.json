  "anti_combinatorial_rules": [
    "Do not author a raster for each complete character combination.",
    "Prefer reusable component families and bounded discrete variants.",
    "Prefer palette zones/ramps over recolored duplicate geometry.",
    "Prefer masks/overlays over baked pattern cross-products.",
    "Use integer-anchor composition where CAS-SD1 quality is preserved.",
    "Only create bounded dependent variant matrices when independent components cannot preserve silhouette/occlusion/fit.",
    "Every demand row records topology/view coverage and required anchors/masks.",
    "Missing production coverage stays a diagnostic; CAPP never rewrites semantic appearance to match the available library."
  ],
  "initial_golden_pack_target": {
    "profile_suite": "CAS-GOLDEN-1",
    "target": "Sufficient reusable coverage to render all golden profiles at full-body, portrait and token, with declared Retrobit projection behavior.",
    "does_not_require": "complete 25-Species production coverage"
  },
