    },
    {
      "id": "operational-metadata",
      "defaultReaders": [
        "authorized-owner-admin",
        "service-actor"
      ],
      "rule": "No protected Character body unless separately authorized."
    },
    {
      "id": "security-sensitive",
      "defaultReaders": [
        "narrow-security-role"
      ],
      "rule": "Purpose-bound and audited."
    },
    {
      "id": "secret-material",
      "defaultReaders": [],
      "rule": "Never returned to ordinary clients, exports, diagnostics, or AI."
    }
