{"schemaVersion":"1.0.0","programId":"MV-IA-001","workItemId":"IA-D04-003","contractId":"MV-IA-TDR-001","version":"0.1.0","status":"implementation-ready-design","owner":"John Brandon Turner","sourceAuthorities":["MV-IA-F021_RECOVERY_AND_OFFLINE_MATRIX.json","MV-IA-F006_ACTION_APPROVAL_MATRIX.json","IA-D04-002_PROPOSAL_APPROVAL_COMPONENT_MATRIX.json","IA-D02-006_SHARED_FOUNDATIONS_CONTRACT_MATRIX.json","IA-D03-005_CHARACTER_CAMPAIGN_CONTRACT_MATRIX.json"],"authorityPrinciple":"Device-local state, caches, review claims, notifications, and realtime messages are advisory. Accepted durable Events and current server projections control.","convergencePrinciple":"Every authorized device converges through stable operation identities, ordered durable Events, status lookup, and current role-safe projections; silent last-write-wins is prohibited.","deviceRoles":["player-device-a","player-device-b","gm-device-a","gm-device-b","assistant-gm-device","observer-device"],"interruptionBoundaries":["before-local-autosave","after-local-autosave-before-submit","after-command-send-before-response","after-receipt-before-durable-proposal","while-pending-decision","after-review-claim-before-decision","after-decision-send-before-response","after-decision-before-consumer-commit","after-consumer-commit-before-projection","during-event-gap-delivery","during-device-switch","after-permission-change","after-entitlement-change","during-service-restart","during-offline-draft-reconciliation"],"stateVocabulary":["local-only","saved-locally","submitted","status-unknown","received","pending-decision","decision-in-review","decision-status-unknown","commit-status-unknown","completed","stale","stale-projection","conflict","forbidden","revoked","event-gap","projection-pending","offline-read-only","recovery-required","role-safe-projection"],"stateVectorFields":["subjectId","authSessionId","deviceId","workspaceId","campaignId","sceneId","sessionId","proposalId","proposalVersion","decisionId","operationId","reviewClaimId","expectedAggregateVersion","lastAcknowledgedSequence","lastProjectionVersion","permissionVersion","entitlementVersion","consumerProfileVersion","packLockDigest","correlationId"],"recoveryActions":["restore-local-draft","lookup-proposal-status","lookup-decision-status","lookup-command-status","release-expired-review-claim","request-current-projection","recover-event-gap","revalidate-selected-context","invalidate-protected-cache","reconcile-draft-conflict","resume-pending-review","acknowledge-current-sequence"],"deniedCases":["cross-subject-device-recovery","cross-campaign-reconnect","stale-auth-session","revoked-player-proposal-status","revoked-gm-review","expired-assistant-gm-delegation","observer-queue-enumeration","hidden-proposal-count","duplicate-conflicting-operation","second-device-silent-last-write-wins","offline-authoritative-submit","offline-authoritative-decision","client-clock-expiry-extension","stale-session-version","stale-target-version","stale-proposal-version","reused-review-claim","decision-after-final-status","protected-cache-retention-after-revocation","event-sequence-skip-without-recovery","unfiltered-history-projection","realtime-message-as-authority","duplicate-consumer-commit","projection-before-authorization"],"scenarios":[{"fixtureId":"TDR-FX-001","scenario":"player-device-a-disconnect-before-autosave","initialState":"local-only","expected":"No authoritative proposal; Device B sees no proposal; local recovery only."},{"fixtureId":"TDR-FX-002","scenario":"player-device-a-disconnect-after-autosave-before-submit","initialState":"saved-locally","expected":"Device A may restore local draft; Device B receives no authoritative proposal."},{"fixtureId":"TDR-FX-003","scenario":"player-submit-response-lost","initialState":"status-unknown","expected":"Both Player devices query by operationId; exactly one durable proposal or definitive rejection."},{"fixtureId":"TDR-FX-004","scenario":"duplicate-player-submit-from-device-b","initialState":"submitted","expected":"Same operation returns prior status; different operation against same draft conflicts safely."},{"fixtureId":"TDR-FX-005","scenario":"player-switches-device-while-pending-gm","initialState":"pending-decision","expected":"Device B recovers the same proposal and role-safe status without resubmission."},{"fixtureId":"TDR-FX-006","scenario":"gm-device-a-disconnect-before-opening-review","initialState":"pending-decision","expected":"Proposal remains queued; no review claim and no decision."},{"fixtureId":"TDR-FX-007","scenario":"gm-device-a-disconnect-after-review-claim","initialState":"decision-in-review","expected":"Claim expires or is released; proposal remains pending and unchanged."},{"fixtureId":"TDR-FX-008","scenario":"gm-device-b-opens-after-claim-expiry","initialState":"pending-decision","expected":"Device B may obtain a new advisory claim after current authorization checks."},{"fixtureId":"TDR-FX-009","scenario":"gm-approve-response-lost","initialState":"commit-status-unknown","expected":"Status lookup recovers one decision and one consumer commit."},{"fixtureId":"TDR-FX-010","scenario":"gm-modify-confirm-response-lost","initialState":"commit-status-unknown","expected":"Original proposal and semantic diff remain; exactly one modified-and-approved outcome."},{"fixtureId":"TDR-FX-011","scenario":"gm-deny-response-lost","initialState":"decision-status-unknown","expected":"Status lookup recovers one durable denial and no consumer mutation."},{"fixtureId":"TDR-FX-012","scenario":"two-gm-devices-race-final-decision","initialState":"decision-race","expected":"One decision wins; losing device receives current final status."},{"fixtureId":"TDR-FX-013","scenario":"player-and-gm-reconnect-after-event-gap","initialState":"event-gap","expected":"Ordered durable Events and current projections converge without duplicate effects."},{"fixtureId":"TDR-FX-014","scenario":"stale-player-projection-after-gm-modification","initialState":"stale-projection","expected":"Player receives current role-safe result; hidden modification evidence remains filtered."},{"fixtureId":"TDR-FX-015","scenario":"stale-gm-review-after-target-version-change","initialState":"stale","expected":"Decision is blocked; proposal evidence is preserved for explicit recovery."},{"fixtureId":"TDR-FX-016","scenario":"permission-revoked-on-player-device-b","initialState":"revoked","expected":"Protected proposal status, caches, and subscriptions are cleared on both Player devices."},{"fixtureId":"TDR-FX-017","scenario":"gm-role-revoked-during-review","initialState":"revoked","expected":"Review claim is invalidated; no decision authority survives."},{"fixtureId":"TDR-FX-018","scenario":"assistant-gm-delegation-expires-between-devices","initialState":"forbidden","expected":"Both devices lose decision controls; protected existence is not disclosed outside scope."},{"fixtureId":"TDR-FX-019","scenario":"offline-player-draft-created-on-device-b","initialState":"offline-read-only","expected":"Draft remains local and nonauthoritative until online revalidation."},{"fixtureId":"TDR-FX-020","scenario":"offline-drafts-diverge-on-two-player-devices","initialState":"conflict","expected":"No silent last-write-wins; safe field comparison and explicit disposition are required."},{"fixtureId":"TDR-FX-021","scenario":"device-clock-skew-during-expiry","initialState":"recovery-required","expected":"Server time and authoritative expiry control."},{"fixtureId":"TDR-FX-022","scenario":"realtime-duplicate-and-out-of-order-delivery","initialState":"event-gap","expected":"Duplicates are ignored; sequence gap triggers authoritative recovery."},{"fixtureId":"TDR-FX-023","scenario":"observer-device-reconnect","initialState":"role-safe-projection","expected":"Observer receives only observer-visible result and no queue or proposal evidence."},{"fixtureId":"TDR-FX-024","scenario":"server-restart-between-decision-and-projection","initialState":"projection-pending","expected":"Decision and c