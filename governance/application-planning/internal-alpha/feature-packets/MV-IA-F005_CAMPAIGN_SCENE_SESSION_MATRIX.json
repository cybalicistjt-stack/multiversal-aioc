  "eventTypes": [
    "CampaignCreated", "CampaignUpdated", "CampaignPolicyChanged", "PackLockChanged",
    "InvitationIssued", "InvitationAccepted", "InvitationDeclined", "InvitationExpired", "InvitationRevoked",
    "MembershipChanged", "RoleGrantChanged", "CharacterControlChanged",
    "SceneCreated", "SceneUpdated", "SceneDuplicated", "SceneReordered", "SceneArchived", "SceneRestored",
    "PlacementAdded", "PlacementUpdated", "PlacementRemoved", "NoteVisibilityChanged",
