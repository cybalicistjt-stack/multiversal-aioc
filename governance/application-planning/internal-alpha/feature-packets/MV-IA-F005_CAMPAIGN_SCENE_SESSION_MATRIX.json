  "recoveryStates": [
    "local-unsaved", "submitted-unknown", "save-accepted-display-missed", "stale-version",
    "conflict-preserved", "invitation-status-unknown", "snapshot-status-unknown",
    "launch-status-unknown", "event-gap", "revoked", "migration-required",
    "checkpoint-available", "export-only-fallback"
  ],
  "offlineRules": {
    "allowed": [
      "read manifest-bound authorized Campaign projections",
      "read manifest-bound authorized Scene projections",
      "edit approved local draft fields and notes",
      "prepare object-selection intentions without authoritative placement",
      "prepare an issue-report draft"
    ],
    "prohibited": [
      "authoritative Campaign or Scene save",
      "invitation issue acceptance decline or revocation",
      "membership role delegation observer or Character-control mutation",
      "pack-lock or entitlement mutation",
      "launch-snapshot creation",
      "Session launch pause resume close or amendment",
      "migration restore or export finalization"
    ]
  },
  "deniedCases": [
    "unauthenticated subject", "wrong Campaign subject", "wrong Scene subject", "wrong Session subject",
    "unaccepted invitation", "expired invitation", "revoked invitation", "revoked membership",
    "wrong active role", "expired assistant-gm delegation", "observer attempting mutation",
    "content creator without Campaign role", "service actor outside scoped operation", "AI attempting mutation",
    "uncontrolled Character selection", "inactive Character", "archived Character", "incompatible Character pack lock",
    "hidden placement exact lookup", "hidden count query", "hidden note retrieval", "private Player note retrieval",
    "unauthorized map or media retrieval", "storage URL enumeration", "cross-Campaign search result",
    "stale permissionVersion", "stale entitlementVersion", "stale packLockDigest", "stale expectedVersion",
    "client-forged role", "client-forged preview", "client-forged placement compatibility",
    "client-forged launch snapshot", "archived Scene launch", "invalid Scene launch",
    "duplicate launch with new operation identity", "offline launch", "offline membership mutation",
    "support actor without separate support access", "issue reporter attempting Campaign access",
    "diagnostic bundle containing Campaign prose or hidden IDs", "AI context requesting hidden Campaign state"
  ],
