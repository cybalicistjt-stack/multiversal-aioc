  "aggregateTypes": [
    "campaign", "scene", "invitation", "membership-grant", "role-grant",
    "character-control-grant", "launch-snapshot", "game-session", "checkpoint"
  ],
  "lifecycleStates": {
    "campaign": ["draft", "active", "migration-required", "archived", "restoring"],
    "scene": ["draft", "validating", "ready", "launch-snapshotted", "retired", "archived"],
    "invitation": ["issued", "accepted", "declined", "expired", "revoked"],
    "session": ["launching", "active", "paused", "closing", "closed", "recovery-required"]
  },
  "fieldClasses": [
    {"fieldClass":"public-campaign-safe","example":"authorized Campaign title or summary","projectionRule":"only when Campaign discovery is authorized"},
    {"fieldClass":"participant-safe","example":"visible Scene description and objectives","projectionRule":"current membership and permission required"},
    {"fieldClass":"player-private","example":"private Player note or preference","projectionRule":"controlling subject and explicitly authorized service only"},
    {"fieldClass":"gm-only","example":"GM note, secret objective, hidden placement","projectionRule":"authorized game-master projection only"},
    {"fieldClass":"assistant-gm-scoped","example":"delegated preparation note","projectionRule":"explicit scope and expiry required"},
    {"fieldClass":"observer-safe","example":"observer Session summary","projectionRule":"explicit observer grant required"},
    {"fieldClass":"owner-operations","example":"migration and recovery administration","projectionRule":"purpose-bound owner-admin operation"},
    {"fieldClass":"support-safe","example":"allowlisted diagnostic state","projectionRule":"issue assignment alone never grants Campaign access"},
    {"fieldClass":"service-internal","example":"operation identity and projection cursor","projectionRule":"minimum scoped service fields only"},
    {"fieldClass":"secret-or-credential","example":"token, key, storage credential","projectionRule":"never included in ordinary projections, exports, diagnostics, or AI"}
  ],
  "placementModel": {
    "sourceIdentityFields": ["definitionId", "definitionVersion", "packId", "packVersion"],
    "placementIdentityFields": ["placementId", "campaignId", "sceneId", "placementVersion"],
    "localFields": ["labelOverride", "initialState", "quantity", "visibilityClass", "positionOrZoneReference", "gmNotes"],
    "rule": "A placement references but never mutates its reusable source Definition."
  },
  "launchSnapshotModel": {
    "requiredFields": [
      "snapshotId", "campaignId", "campaignVersion", "sceneId", "sceneVersion",
      "rulesProfileId", "rulesProfileVersion", "packLockDigest", "schemaVersions",
      "participantBindings", "characterBindings", "placementVersions", "visibilityPolicyVersion",
      "validationReceiptId", "contentDigest", "createdBy", "createdAt"
    ],
    "authorityRule": "A Session launches only from an immutable validated launch snapshot.",
    "postLaunchEditRule": "Later Scene edits do not mutate an active Session and require a new snapshot or governed amendment."
  },
  "validationClasses": [
    "required-field", "stable-id-reference", "source-version", "campaign-isolation",
    "permission", "entitlement", "pack-present", "pack-version", "pack-dependency",
    "rules-profile", "schema-compatibility", "visibility-safety", "note-classification",
    "character-control", "character-lifecycle", "participant-membership", "role-scope",
    "assistant-gm-delegation", "observer-grant", "map-alternative", "media-reference",
    "objective-entry-condition", "duplicate-placement-policy", "launch-readiness"
  ],
  "operationTypes": [
