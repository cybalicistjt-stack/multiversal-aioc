    "campaign",
    "character",
    "scene",
    "game-session",
    "creator-draft",
    "observer-session",
    "owner-admin-operations"
  ],
  "entryFlows": [
    {
      "id": "first-approved-alpha-entry",
      "reauthorizationPoints": [
        "subject-resolution",
        "session-establishment",
        "dashboard-load",
        "workspace-selection"
      ]
    },
    {
      "id": "accept-invitation",
      "reauthorizationPoints": [
        "safe-preview",
        "recipient-binding",
        "acceptance",
        "membership-and-role-creation",
        "dashboard-refresh"
      ]
    },
    {
      "id": "return-to-recent-work",
      "reauthorizationPoints": [
        "recent-work-list",
        "recent-work-open",
        "context-receipt-issue"
      ]
    },
    {
      "id": "switch-campaign-or-role",
      "reauthorizationPoints": [
        "alternative-list",
        "target-selection",
        "new-context-entry"
      ]
    },
    {
      "id": "deep-link-entry",
      "reauthorizationPoints": [
        "target-resolution",
        "route-authorization",
        "initial-projection"
      ]
    },
    {
      "id": "sign-out-or-revocation",
      "reauthorizationPoints": [
        "session-end",
        "subscription-end",
        "protected-cache-clear"
      ]
    }
  ],
