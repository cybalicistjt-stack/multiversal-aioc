{
  "schemaVersion": "1.0.0",
  "programId": "MV-IA-001",
  "featureId": "MV-IA-F003",
  "featureVersion": "0.1.0",
  "status": "implementation-ready-design",
  "owner": "John Brandon Turner",
  "defaultWorkspaceDecision": "deny",
  "identityPrinciples": [
    "Stable Multiversal subject identity is independent of provider identity, email, display name, device, and current role.",
    "Workspace discovery and entry are separate authorization decisions.",
    "Membership, role, Character control, ownership, and entitlement are separate decisions.",
    "A selected-context receipt assists navigation but never replaces server authorization.",
    "Provider-specific SDKs and identifiers remain inside adapters and mapping records.",
    "Protected workspace existence is not disclosed to unauthorized subjects."
  ],
  "roles": [
    {
      "id": "invited-tester",
      "dashboardScope": "safe invitation and onboarding only",
      "entryScope": "none until valid acceptance and authorization"
    },
    {
      "id": "player",
      "dashboardScope": "authorized Campaigns, controlled Characters, permitted Sessions, own notifications and recent work",
      "entryScope": "Player-safe Campaign and Session projections"
    },
    {
      "id": "game-master",
      "dashboardScope": "Campaigns with active GM role, GM preparation, and permitted live Sessions",
      "entryScope": "GM-authorized Campaign and Session projections"
    },
    {
      "id": "assistant-gm",
      "dashboardScope": "explicitly delegated Campaigns and feature areas",
      "entryScope": "delegation-limited GM projection"
    },
    {
      "id": "content-creator",
      "dashboardScope": "own or assigned drafts and permitted canonical library views",
      "entryScope": "creator draft or review workspace"
    },
    {
      "id": "observer",
      "dashboardScope": "explicitly granted read-only Campaign or Session references",
      "entryScope": "observer-safe projection"
    },
    {
      "id": "owner-admin",
      "dashboardScope": "program operations, alpha administration, and operational metadata",
      "entryScope": "operational workspaces; protected play content only through governed Campaign role or support-access record"
    },
    {
      "id": "service-actor",
      "dashboardScope": "none",
      "entryScope": "operation-specific service scope only"
    }
  ],
  "identityObjects": [
    "stable-subject",
    "external-identity-mapping",
    "authentication-session",
    "invitation",
    "campaign-membership",
    "role-assignment",
    "character-control-grant",
    "workspace-reference",
    "recent-work-reference",
    "selected-context-receipt",
    "dashboard-projection",
    "audit-event",
    "security-event"
  ],
