{
  "schemaVersion": "1.0.0",
  "programId": "MV-IA-001",
  "featureId": "MV-IA-F025",
  "featureVersion": "0.1.0",
  "status": "implementation-ready-design",
  "owner": "John Brandon Turner",
  "defaultHelpDecision": "deny-unless-topic-is-public-or-context-authorized",
  "defaultDiagnosticDecision": "exclude",
  "defaultIssueDecision": "deny",
  "roles": [
    {
      "role": "invited-tester",
      "scope": "assigned alpha release and permitted workspaces"
    },
    {
      "role": "player",
      "scope": "Player-safe active context and own reports"
    },
    {
      "role": "game-master",
      "scope": "GM-authorized active Campaign and own or assigned reports"
    },
    {
      "role": "assistant-gm",
      "scope": "delegated Campaign and report scope"
    },
    {
      "role": "content-creator",
      "scope": "creator workspace and own reports"
    },
    {
      "role": "observer",
      "scope": "observer-safe workspace and own reports"
    },
    {
      "role": "owner-admin",
      "scope": "approved administration and separately authorized support scope"
    },
    {
      "role": "service-actor",
      "scope": "narrow manifest, storage, intake, notification, and export operations"
    },
    {
      "role": "ai",
      "scope": "optional redacted read-only proposed assistance"
    }
  ],
  "onboardingStages": [
    "release-identification",
    "invitation-and-role-confirmation",
    "alpha-boundary-acknowledgement",
    "workspace-entry",
    "supported-journey-introduction",
    "first-success-task",
    "help-discovery",
    "known-limitations-review",
    "issue-report-introduction",
    "completion-and-resume"
  ],
  "helpContexts": [
    "global-shell",
    "identity-entry",
    "dashboard",
    "workspace-selection",
    "universal-object",
    "character",
    "campaign-builder",
    "scene-builder",
