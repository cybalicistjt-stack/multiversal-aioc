  "issueCategories": [
    "access-or-invitation",
    "permission-or-hidden-information",
    "entitlement",
    "content-or-pack",
    "save-or-persistence",
    "realtime-or-reconnect",
    "recovery-or-restore",
    "ui-or-responsive",
    "accessibility",
    "performance",
    "rules-or-resolution",
    "data-or-migration",
    "diagnostics-or-reporting",
    "documentation-or-help",
    "security-or-privacy",
    "other"
  ],
  "severityValues": [
    {
      "id": "informational",
      "meaning": "question, suggestion, or minor wording issue"
    },
    {
      "id": "minor",
      "meaning": "workaround exists and primary path continues"
    },
    {
      "id": "major",
      "meaning": "important workflow degraded or data at risk"
    },
    {
      "id": "blocking",
      "meaning": "approved alpha journey cannot continue"
    },
    {
      "id": "security-privacy",
      "meaning": "possible unauthorized access, secret, or privacy exposure; routes to protected handling"
    }
  ],
  "releaseIdentityRequiredFields": [
    "releaseId",
    "applicationVersion",
    "buildId",
    "commitId",
    "environmentClass",
    "schemaVersion",
    "migrationVersion",
    "packSetDigest",
    "releasedAt",
    "supportPolicyId"
  ],
  "issueReportRequiredFields": [
    "issueReportId",
    "reporterSubjectId",
    "releaseId",
    "roleContext",
    "selectedContextType",
    "categoryId",
    "severityId",
    "reproducibility",
    "blocksApprovedJourney",
    "title",
    "expectedResult",
    "actualResult",
    "reproductionSteps",
    "submissionOperationId",
    "createdAt"
  ],
  "diagnosticManifestRequiredFields": [
    "diagnosticBundleId",
    "issueDraftId",
    "releaseId",
    "generatedAt",
    "generatorVersion",
    "fieldDefinitions",
    "includedFields",
    "excludedFieldCountByClass",
    "redactionCountByClass",
    "attachmentIds",
    "consentId",
    "manifestSha256"
  ],
  "issueReceiptRequiredFields": [
    "issueReceiptId",
    "issueReportId",
    "submissionOperationId",
    "releaseId",
    "submittedAt",
    "safeSummary",
    "status",
    "statusVersion",
    "receiptSha256"
  ],
  "protectedDiagnosticSurfaces": [
    {
      "surface": "identity-session",
      "default": "exclude raw provider values and tokens"
    },
    {
      "surface": "selected-context",
      "default": "include safe IDs only after authorization"
    },
    {
      "surface": "campaign",
      "default": "exclude unrelated Campaigns"
    },
    {
      "surface": "character",
      "default": "exclude uncontrolled and hidden Characters"
    },
    {
      "surface": "scene",
      "default": "exclude GM truth from Player reports"
    },
    {
      "surface": "session",
      "default": "include safe sequence and state only"
    },
    {
      "surface": "operations",
      "default": "include stable IDs and safe result codes"
    },
    {
      "surface": "commands",
      "default": "include ID and status, not unauthorized payload"
    },
    {
      "surface": "events",
      "default": "include sequence and safe type, not hidden payload"
    },
    {
      "surface": "checkpoints",
      "default": "include ID and verification status"
    },
    {
      "surface": "logs",
      "default": "allowlisted excerpts after redaction and preview"
    },
    {
      "surface": "screenshots",
      "default": "explicit user selection only"
    },
    {
      "surface": "attachments",
      "default": "quarantine until validated and report-bound"
    },
    {
      "surface": "network",
      "default": "exclude headers, cookies, tokens, and full bodies"
    },
    {
      "surface": "storage",
      "default": "exclude raw database and filesystem dumps"
    },
    {
      "surface": "permissions",
      "default": "include user-safe reason codes, not policy internals"
    },
    {
      "surface": "entitlements",
      "default": "include safe decision reason, not protected catalog"
    },
    {
      "surface": "performance",
      "default": "include bounded timings and sizes"
    },
    {
      "surface": "accessibility",
      "default": "include user-selected preferences without sensitive health inference"
    },
    {
      "surface": "device",
      "default": "include coarse platform and version only"
    },
    {
      "surface": "location",
      "default": "exclude unless separately approved"
    },
    {
      "surface": "ai",
      "default": "exclude prompts and retrieved hidden content"
    },
    {
      "surface": "support-access",
      "default": "include request and approval IDs, not content"
    },
    {
      "surface": "issue-index",
      "default": "no protected counts or duplicate enumeration"
    }
  ],
  "requiredDeniedCases": [
    "player-diagnostics-exclude-gm-truth",
    "gm-diagnostics-exclude-unrelated-campaign",
    "reporter-cannot-attach-other-subject-private-notes",
    "observer-cannot-enumerate-hidden-participants",
    "creator-cannot-view-campaign-reports-without-authority",
    "support-cannot-open-unassigned-report",
    "owner-admin-has-no-blanket-content-access",
    "revoked-subject-cannot-retrieve-attachment",
    "deep-link-to-other-report-is-safe-unavailable",
    "help-search-does-not-reveal-hidden-feature",
    "manifest-excludes-secrets-and-tokens",
    "logs-redacted-before-preview",
    "screenshot-requires-explicit-selection",
