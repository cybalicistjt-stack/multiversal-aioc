  "attachmentRules": {
    "automaticCapture": false,
    "previewRequired": true,
    "explicitSelectionRequired": true,
    "removalBeforeSubmissionRequired": true,
    "quarantineRequired": true,
    "checksumRequired": true,
    "classificationRequired": true,
    "maxCountAndSize": "owner-approved alpha policy"
  },
  "alwaysExcludedDiagnosticClasses": [
    "password",
    "access-token",
    "refresh-token",
    "cookie",
    "credential",
    "private-key",
    "raw-authorization-header",
    "payment-data",
    "unrelated-campaign-data",
    "unselected-private-note",
    "unselected-gm-truth",
    "raw-database-dump",
    "full-filesystem-inventory"
  ],
  "zeroServiceRequirements": [
