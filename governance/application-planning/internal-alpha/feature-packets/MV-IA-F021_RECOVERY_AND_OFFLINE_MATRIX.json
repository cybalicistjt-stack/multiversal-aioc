    "corrupt-manifest-capability-escalation",
    "second-device-silent-last-write-wins",
    "offline-gm-approval-as-accepted",
    "checkpoint-with-invalid-digest",
    "restore-that-erases-event-history"
  ],
  "requiredReceipts": [
