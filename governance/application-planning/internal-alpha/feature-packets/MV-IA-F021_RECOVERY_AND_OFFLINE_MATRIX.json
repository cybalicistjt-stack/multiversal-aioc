{
  "schemaVersion": "1.0.0",
  "programId": "MV-IA-001",
  "featureId": "MV-IA-F021",
  "featureVersion": "0.1.0",
  "status": "implementation-ready-design",
  "owner": "John Brandon Turner",
  "authoritativePrinciple": "Local drafts, caches, realtime messages, and offline snapshots are nonauthoritative. Accepted durable Events and current server projections control.",
  "stateVocabulary": [
    {
      "id": "local-only",
      "authoritative": false,
      "description": "User work exists only in memory or a local draft store."
    },
    {
      "id": "saved-locally",
      "authoritative": false,
      "description": "A local draft revision has a verified autosave receipt."
    },
    {
      "id": "queued-for-submit",
      "authoritative": false,
      "description": "The client intends to submit when connectivity and authorization permit."
    },
    {
      "id": "submitted",
      "authoritative": false,
      "description": "A command left the client; acceptance is not yet known."
    },
    {
      "id": "status-unknown",
      "authoritative": false,
      "description": "The client cannot determine whether the service received or accepted the command."
    },
    {
      "id": "received",
      "authoritative": false,
      "description": "The authoritative service recorded receipt and is processing."
    },
    {
      "id": "pending-gm",
      "authoritative": false,
      "description": "A durable proposal awaits an authorized GM decision."
    },
    {
      "id": "accepted",
      "authoritative": true,
      "description": "The service committed the approved result and Event history."
    },
    {
      "id": "modified-and-accepted",
      "authoritative": true,
      "description": "The GM-authorized modified result committed with original calculation retained."
    },
    {
      "id": "rejected",
      "authoritative": true,
      "description": "The service or GM recorded a rejection without the proposed business effect."
    },
    {
      "id": "stale",
      "authoritative": false,
      "description": "The expected version no longer matches current authoritative state."
    },
    {
      "id": "conflict",
      "authoritative": false,
      "description": "Local and authoritative states require a governed disposition."
    },
    {
      "id": "forbidden",
      "authoritative": false,
      "description": "Current authorization does not permit the requested recovery or action."
    },
    {
      "id": "entitlement-restricted",
      "authoritative": false,
      "description": "Current content access does not permit the requested use."
    },
    {
      "id": "offline-read-only",
      "authoritative": false,
      "description": "An unexpired manifest permits bounded cached reading and local draft creation."
    },
    {
      "id": "recovery-required",
      "authoritative": false,
      "description": "The client must complete a guided recovery operation before continuing."
    }
  ],
  "operationTypes": [
    {
      "id": "draft-autosave",
      "idempotencyKey": "draftId+localRevision",
      "requiresOnline": false,
      "mayMutateAuthoritativeState": false
    },
    {
      "id": "authoritative-save",
      "idempotencyKey": "clientOperationId",
      "requiresOnline": true,
      "mayMutateAuthoritativeState": true
    },
    {
      "id": "session-command",
      "idempotencyKey": "commandId",
      "requiresOnline": true,
      "mayMutateAuthoritativeState": true
    },
    {
      "id": "command-status-lookup",
      "idempotencyKey": "lookupOperationId",
      "requiresOnline": true,
      "mayMutateAuthoritativeState": false
    },
    {
      "id": "event-gap-recovery",
      "idempotencyKey": "sessionId+lastAcknowledgedSequence",
      "requiresOnline": true,
      "mayMutateAuthoritativeState": false
    },
    {
      "id": "selected-context-revalidation",
      "idempotencyKey": "contextReceiptId+permissionVersion",
      "requiresOnline": true,
      "mayMutateAuthoritativeState": false
    },
    {
      "id": "draft-reconciliation",
      "idempotencyKey": "draftId+baseVersion+currentVersion",
      "requiresOnline": true,
      "mayMutateAuthoritativeState": false
    },
    {
      "id": "checkpoint-recovery",
      "idempotencyKey": "recoveryOperationId",
      "requiresOnline": true,
      "mayMutateAuthoritativeState": true
    },
    {
      "id": "offline-snapshot-issue",
      "idempotencyKey": "snapshotOperationId",
      "requiresOnline": true,
      "mayMutateAuthoritativeState": false
    },
    {
      "id": "offline-snapshot-purge",
      "idempotencyKey": "snapshotId+purgeVersion",
      "requiresOnline": false,
      "mayMutateAuthoritativeState": false
    }
  ],
  "interruptionPoints": [
    "before-local-autosave",
    "after-local-autosave-before-submit",
    "during-authoritative-save",
    "after-command-send-before-response",
    "after-receipt-before-acceptance",
    "while-pending-gm",
    "after-event-commit-before-display",
    "during-event-gap-delivery",
    "during-selected-context-switch",
    "after-permission-or-entitlement-change",
    "during-service-restart",
    "during-checkpoint-verification",
    "while-using-offline-snapshot",
    "during-offline-draft-reconciliation",
    "during-second-device-conflict"
  ],
  "offlineCapabilities": {
    "allowed": [
      "read-manifest-listed-authorized-projections",
      "search-within-manifest-listed-local-index",
      "inspect-cached-source-safe-fields",
      "create-approved-local-draft-types",
      "edit-approved-local-draft-types",
      "view-local-draft-history",
      "prepare-nonauthoritative-action-proposal"
    ],
    "prohibited": [
      "authoritative-save",
      "accepted-session-command",
      "gm-approval-as-committed",
      "ownership-transfer",
      "entitlement-change",
      "role-or-permission-change",
      "pack-install-update-or-removal",
      "canonical-promotion",
      "checkpoint-or-restore-operation",
      "provider-exit-export",
      "claim-that-local-state-is-authoritative"
    ],
    "requiredManifestFields": [
      "snapshotId",
      "subjectId",
      "selectedContextId",
      "includedStableIds",
      "visibilityClasses",
      "permissionVersion",
      "entitlementVersion",
      "packLockDigest",
      "schemaVersions",
      "createdAt",
      "expiresAt",
      "allowedReadCapabilities",
      "allowedDraftTypes",
      "prohibitedOperations",
      "contentDigest",
      "manifestDigest",
      "encryptionStatus"
    ]
  },
  "protectedRecoverySurfaces": [
    "local-draft-body",
    "draft-status-and-timestamps",
    "recent-work",
    "selected-context",
    "command-status",
    "pending-approval-queue",
