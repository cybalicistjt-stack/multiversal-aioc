{
  "advancedRules": {
    "experimentalAlchemy": {
      "activation": "requires perk:experimental-alchemy",
      "rule": "Combine two potion recipes; Mixing DC +3; failure becomes unstable and uses Potion Interaction Table."
    },
    "masterBrewer": {
      "activation": "requires perk:master-brewer",
      "rule": "Catalyzing and Stabilizing checks automatically succeed; source market-sale bonus remains provenance only and does not override MIB-13."
    },
    "multiPotionBrewing": {
      "activation": "requires perk:multi-potion-brewing",
      "tier3": "two identical potions simultaneously; ingredients consumed normally",
      "tier5MassProduction": "up to five identical potions simultaneously; ingredients consumed normally"
    },
    "rareIngredientMastery": {
      "activation": "requires perk:rare-ingredient-mastery",
      "rule": "Reduce rare ingredient requirement by 1 where a potion requires rare components; source additionally says Exotic potions reduce rare component requirements by 1. Never reduce below zero."
    }
  },
