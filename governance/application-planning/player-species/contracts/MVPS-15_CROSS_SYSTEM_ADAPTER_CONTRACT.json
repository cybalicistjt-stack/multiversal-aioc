      "owner_domain",
      "target_owner_ref_or_slot",
      "provenance_refs",
      "state"
    ],
    "states": [
      "proposal",
      "resolved",
      "unresolved"
    ],
    "source_owner_refs_preserved": true,
    "exact_species_version_preserved": true,
    "provenance_preserved": true,
    "unresolved_target_not_inferred": true,
    "canonical_mutation_requires_target_owner_workflow": true
