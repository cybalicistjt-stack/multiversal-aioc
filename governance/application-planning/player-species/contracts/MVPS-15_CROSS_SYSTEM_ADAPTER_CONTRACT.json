{
  "schema_version": "1.0.0",
  "contract_id": "MVPS.SpeciesCrossSystemAdapters",
  "record_type": "SpeciesCrossSystemAdapterContract",
  "status": "MVPS-15_CANONICAL_CONTRACT",
  "purpose": "Define species-facing mapping/projection adapters into campaign, combat, social, exploration and crafting owner domains without moving domain rule authority into MVPS.",
