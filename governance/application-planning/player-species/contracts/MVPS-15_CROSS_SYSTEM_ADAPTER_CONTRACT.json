      "source_owner_refs_preserved": true,
      "projection_or_mapping_only": true,
      "canonical_owner_mutation_performed": false,
      "domain_engine_reimplemented": false,
      "participant_source_reference_preserved": true,
      "current_projection_reference_owned_by_combat_runtime": true,
      "participant_type_does_not_change_species_identity": true
    },
    "social": {
      "owner_contract": "Relationship/Reputation/Faction/Knowledge/Visibility owners",
      "source_owner_refs_preserved": true,
      "projection_or_mapping_only": true,
      "canonical_owner_mutation_performed": false,
      "domain_engine_reimplemented": false,
      "species_identity_is_context_not_behavior_stereotype": true,
      "culture_and_learned_language_remain_separate": true
    },
    "exploration": {
