      "source_owner_refs_preserved": true,
      "projection_or_mapping_only": true,
      "canonical_owner_mutation_performed": false,
      "domain_engine_reimplemented": false,
      "morphology_interface_compatibility_consumed_by_owner": true,
      "natural_equipment_and_capability_refs_not_copied_into_recipe": true
    }
  },
