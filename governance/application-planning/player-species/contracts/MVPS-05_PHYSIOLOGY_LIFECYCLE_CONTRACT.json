{
  "schema_version": "1.0.0",
  "contract_id": "MVPS.SpeciesPhysiologyLifecycle",
  "record_type": "SpeciesPhysiologyLifecycle",
  "status": "MVPS-05_CANONICAL_CONTRACT",
  "purpose": "Separate descriptive species biology and lifecycle metadata from executable physiology mechanics, which must be represented by typed references to shared records and rules.",
  "source_basis": [
    "PROJECT_BIBLE_OPS3_REFERENCE.md §25.3 Species",
    "PROJECT_BIBLE_OPS3_REFERENCE.md §25.6 Environmental adaptations",
    "PROJECT_BIBLE_OPS3_REFERENCE.md §14 Conditions and Statuses",
    "PROJECT_BIBLE_OPS3_REFERENCE.md §15 Resources",
    "DevelopmentBible/02-game-framework/creatures-npcs-and-species.md",
    "MVPS-01 descriptive-vs-executable separation"
  ],
  "biology_descriptor": {
    "execution_policy": "non_executable",
    "may_infer_mechanics": false,
    "may_create_conditions_or_resources": false,
    "allowed_descriptive_domains": [
      "anatomical or biological description",
      "metabolism description",
      "respiration description",
      "diet or sustenance description",
      "sleep/rest description",
      "lifespan description",
      "development-stage description",
      "reproduction description where authored"
    ],
    "rule": "Descriptive biology may explain canon but cannot itself grant immunity, resistance, resource behavior, recovery, respiration, sustenance, rest, aging effects or environmental survival."
  },
  "missing_mechanics_policy": "unresolved_not_inferred",
  "physiology_hooks": {
    "hook_types": [
      "respiration",
      "sustenance",
      "rest_recovery"
    ],
    "hook_contract": {
      "required": [
        "record_ref",
        "hook_type",
        "source_ref",
        "rules_profile_ref"
      ],
      "optional": [
        "condition_refs",
        "resource_refs",
        "effect_refs",
        "activation_ref",
        "projection_tags"
      ],
      "rule": "Executable physiology uses canonical shared records. Species provides source/provenance and references; it does not copy formulas or condition/resource definitions."
    },
    "inline_formula_allowed": false,
    "local_condition_or_resource_definition_allowed": false
  },
  "lifecycle": {
    "development_metadata_policy": "descriptive_unless_rule_referenced",
    "descriptive_fields": [
      "lifespan",
      "maturity_notes",
      "development_stages",
      "senescence_notes"
    ],
    "mechanical_transition_policy": "shared_rule_or_effect_reference_only",
    "mechanical_transition_contract": {
      "required": [
        "transition_ref",
        "source_ref",
        "rules_profile_ref"
      ],
      "optional": [
        "condition_refs",
        "effect_refs",
        "event_ref",
        "projection_tags"
      ],
      "rule": "If an age/development transition has mechanics, those mechanics are executed by shared rule/effect/event owners. Species progression/unlock-tree semantics remain MVPS-10."
    },
    "inline_aging_formula_allowed": false,
    "progression_unlock_semantics_owned_here": false
  },
  "shared_owner_dependencies": [
    "Condition",
    "Resource",
    "Effect",
    "Modifier",
    "Event",
    "RulesProfile"
  ],
  "provenance_policy": {
    "source_ref_required": true,
    "rules_profile_ref_required_for_executable_hooks": true
  },
  "extension_policy": {
    "namespace_required": true,
    "override_core_fields": false
  }
}
