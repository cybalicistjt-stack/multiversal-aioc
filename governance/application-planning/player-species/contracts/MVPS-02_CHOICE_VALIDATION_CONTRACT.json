{
  "schema_version": "1.0.0",
  "contract_id": "MVPS.SpeciesChoiceValidationResult",
  "record_type": "SpeciesChoiceValidationResult",
  "status": "MVPS-02_CANONICAL_CONTRACT",
  "purpose": "Return deterministic, sourced validation for species creation choices and explain why each choice is legal, blocked or advisory.",
  "source_basis": [
    "PROJECT_BIBLE_OPS3_REFERENCE.md §9.4 Validation gates",
    "PROJECT_BIBLE_OPS3_REFERENCE.md §25.4 Species choice layers",
    "DB-004 characters-and-progression.md Creation and validation"
  ],
  "severity_order": [
    "blocking",
    "advisory",
    "info"
  ],
  "required_checks": [
    "required_choices",
    "budgets",
    "prerequisites",
    "mutual_exclusions",
    "source_availability",
    "campaign_restrictions",
    "setting_restrictions",
    "entitlement_constraints"
  ],
  "issue_contract": {
    "required": [
      "issue_id",
      "severity",
      "code",
      "subject_ref",
      "rule_source_ref",
      "explanation"
    ],
    "optional": [
      "choice_group_id",
      "option_id",
      "related_refs",
      "suggested_resolution_refs"
    ],
    "rule_source_required": true
  },
  "choice_result_contract": {
    "required": [
      "choice_group_id",
      "option_id",
      "result",
      "choice_source_ref",
      "explanation"
    ],
    "result_enum": [
      "legal",
      "blocked",
      "advisory",
      "unresolved"
    ],
    "choice_source_required": true,
    "explanation_required": true
  },
  "summary_contract": {
    "required": [
      "blocking_count",
      "advisory_count",
      "unresolved_required_count",
      "valid_playable"
    ],
    "valid_playable_rule": "true only when blocking_count == 0 and unresolved_required_count == 0 and all required creation gates pass"
  },
  "duplicate_grant_policy": {
    "shared_owner_rule_applies": true,
    "local_resolution_forbidden": true,
    "explanation_required_when_blocked_or_converted": true
  },
  "source_unavailable_policy": {
    "preserve_historical_reference": true,
    "new_selection_requires_available_source_or_explicit_adjudication": true
  }
}
