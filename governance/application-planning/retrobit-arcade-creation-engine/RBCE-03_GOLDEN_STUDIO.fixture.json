    {"surfaceId": "surface:playtest", "label": "Playtest", "modes": ["studio:playtest"], "projectAreas": ["gameplay", "scenes", "actors", "assets", "inputs", "variables", "outcomes", "audio", "tests"], "allowsArbitraryScript": false, "ownerMutationAuthority": false}
