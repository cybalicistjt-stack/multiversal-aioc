    {
      "operationId": "operation:constraint-preview",
      "modes": ["asset:palette", "asset:sprite", "asset:tiles"],
      "changesImageBytes": false,
      "requiresTransformPermission": false,
      "createsDerivedAsset": false,
      "ownerMutationAuthority": false,
      "arbitraryScript": false
    }
  ],
  "permissionModel": {
    "permissionDimensions": [
      "ingest",
      "useInExperience",
      "transform",
      "substitute",
      "redistribute"
    ],
    "silenceMeansPermission": false,
    "transformImpliesUse": false,
    "transformImpliesRedistribute": false,
    "networkAcquisitionAllowed": false,
    "sourceEvidenceImmutable": true
  },
  "authoringGuarantees": {
    "localFirst": true,
    "providerOffComplete": true,
    "aiRequired": false,
    "undoRedo": true,
    "autosaveRecovery": true,
    "nonDestructiveImportedSources": true,
    "keyboardEssentialTools": true,
    "numericSpatialAlternative": true
  },
  "handoff": {
    "boundary": "mai-handoff",
    "targets": ["MAI", "RBCE-03", "RBCE-02"],
    "publishesPack": false,
    "mutatesCanonicalGameplay": false,
    "preservesProvenance": true,
    "requiresDeterministicLineageReceipt": true
  },
  "acceptanceWorkflows": [
    {"workflowId":"workflow:original-player","proves":"original-pixel-creation","requiredModes":["asset:pixel-edit"]},
    {"workflowId":"workflow:permitted-sheet-intake","proves":"evidence-aware-intake","requiredModes":["asset:intake"]},
    {"workflowId":"workflow:slice-stable-frames","proves":"deterministic-slicing","requiredModes":["asset:sprite"]},
    {"workflowId":"workflow:idle-walk-animation","proves":"animation-authoring","requiredModes":["asset:animation"]},
    {"workflowId":"workflow:anchor-offset","proves":"anchor-offset-authoring","requiredModes":["asset:sprite"]},
    {"workflowId":"workflow:terrain-sheet","proves":"tile-extraction","requiredModes":["asset:tiles"]},
    {"workflowId":"workflow:terrain-visual-only","proves":"visual-terrain-no-gameplay-truth","requiredModes":["asset:tiles"]},
    {"workflowId":"workflow:inspired-palette-preview","proves":"palette-constraint-preview","requiredModes":["asset:palette"]},
    {"workflowId":"workflow:block-unknown-transform","proves":"transform-permission-block","requiredModes":["asset:intake","asset:palette"]},
    {"workflowId":"workflow:placeholder-explicit","proves":"explicit-placeholder-policy","requiredModes":["asset:intake"]},
    {"workflowId":"workflow:deterministic-atlas","proves":"deterministic-derived-atlas","requiredModes":["asset:sprite","asset:animation"]},
    {"workflowId":"workflow:studio-handoff","proves":"studio-handoff-no-owner-mutation","requiredModes":["asset:sprite","asset:tiles"]},
    {"workflowId":"workflow:draft-recovery","proves":"draft-recovery","requiredModes":["asset:pixel-edit"]},
    {"workflowId":"workflow:provider-off","proves":"provider-off-ai-disabled","requiredModes":["asset:intake","asset:pixel-edit"]}
  ]
}
