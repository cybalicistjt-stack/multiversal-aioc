{
  "schemaId": "RBCE04.ASSET_WORKBENCH.v1",
  "schemaVersion": "1.0.0",
  "defaultSkinId": "retrobit-classic-arcade",
  "modes": [
    "asset:intake",
    "asset:pixel-edit",
    "asset:sprite",
    "asset:animation",
    "asset:tiles",
    "asset:palette"
  ],
  "workbenchRoles": [
    "retro-role:pixel-canvas",
    "retro-role:sprite-sheet",
    "retro-role:sprite-atlas",
    "retro-role:animated-sprite",
    "retro-role:tile-sheet",
    "retro-role:tileset",
    "retro-role:background-layer",
    "retro-role:foreground-layer",
    "retro-role:ui-sprite",
    "retro-role:effect-sprite",
    "retro-role:object-sprite"
  ],
  "operations": [
    {
      "operationId": "operation:new-pixel-canvas",
      "modes": ["asset:pixel-edit"],
      "changesImageBytes": true,
      "requiresTransformPermission": true,
      "createsDerivedAsset": true,
      "ownerMutationAuthority": false,
      "arbitraryScript": false
    },
    {
      "operationId": "operation:pencil",
      "modes": ["asset:pixel-edit"],
      "changesImageBytes": true,
      "requiresTransformPermission": true,
      "createsDerivedAsset": true,
      "ownerMutationAuthority": false,
      "arbitraryScript": false
    },
    {
