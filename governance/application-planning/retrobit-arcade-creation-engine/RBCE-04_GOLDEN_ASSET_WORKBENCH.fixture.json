      "arbitraryScript": false
    },
    {
      "operationId": "operation:set-anchor",
      "modes": ["asset:sprite", "asset:animation"],
      "changesImageBytes": false,
      "requiresTransformPermission": false,
      "createsDerivedAsset": false,
      "ownerMutationAuthority": false,
      "arbitraryScript": false
    },
    {
      "operationId": "operation:set-draw-offset",
      "modes": ["asset:sprite", "asset:animation"],
      "changesImageBytes": false,
      "requiresTransformPermission": false,
      "createsDerivedAsset": false,
      "ownerMutationAuthority": false,
      "arbitraryScript": false
    },
    {
      "operationId": "operation:animation-group",
      "modes": ["asset:animation"],
