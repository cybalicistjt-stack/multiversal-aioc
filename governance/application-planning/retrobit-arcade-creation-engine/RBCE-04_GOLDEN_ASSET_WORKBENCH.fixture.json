      "modes": ["asset:pixel-edit"],
      "changesImageBytes": true,
      "requiresTransformPermission": true,
      "createsDerivedAsset": true,
      "ownerMutationAuthority": false,
      "arbitraryScript": false
    },
    {
      "operationId": "operation:fill",
      "modes": ["asset:pixel-edit"],
      "changesImageBytes": true,
      "requiresTransformPermission": true,
      "createsDerivedAsset": true,
      "ownerMutationAuthority": false,
      "arbitraryScript": false
    },
    {
      "operationId": "operation:line",
      "modes": ["asset:pixel-edit"],
      "changesImageBytes": true,
      "requiresTransformPermission": true,
      "createsDerivedAsset": true,
      "ownerMutationAuthority": false,
      "arbitraryScript": false
    },
    {
      "operationId": "operation:rectangle",
      "modes": ["asset:pixel-edit"],
      "changesImageBytes": true,
      "requiresTransformPermission": true,
      "createsDerivedAsset": true,
      "ownerMutationAuthority": false,
      "arbitraryScript": false
    },
    {
      "operationId": "operation:selection-move",
      "modes": ["asset:pixel-edit"],
      "changesImageBytes": true,
      "requiresTransformPermission": true,
      "createsDerivedAsset": true,
      "ownerMutationAuthority": false,
      "arbitraryScript": false
    },
    {
      "operationId": "operation:color-replace",
      "modes": ["asset:pixel-edit", "asset:palette"],
      "changesImageBytes": true,
      "requiresTransformPermission": true,
      "createsDerivedAsset": true,
      "ownerMutationAuthority": false,
      "arbitraryScript": false
    },
    {
      "operationId": "operation:crop",
      "modes": ["asset:sprite", "asset:tiles"],
      "changesImageBytes": true,
      "requiresTransformPermission": true,
      "createsDerivedAsset": true,
      "ownerMutationAuthority": false,
      "arbitraryScript": false
