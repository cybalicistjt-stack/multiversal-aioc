{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multiversal.local/schemas/interaction-control-receipt-1.0.0.schema.json",
  "title": "Multiversal Interaction Control Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "control_type",
    "work_item_id",
    "created_at",
    "status",
    "details",
    "evidence"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "receipt_id": {"type": "string", "pattern": "^MV-ICR-[0-9]{3}$"},
    "control_type": {
      "enum": [
        "deliverable",
        "capability",
        "source_coverage",
        "ui_verification",
        "notification",
        "request_alignment",
        "owner_report"
      ]
    },
    "work_item_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["pass", "fail", "send", "suppress"]},
    "details": {"type": "object"},
    "evidence": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  }
}
