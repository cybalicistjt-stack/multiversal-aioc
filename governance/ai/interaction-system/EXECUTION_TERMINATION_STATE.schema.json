{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://multiversal.invalid/schemas/execution-termination-state.schema.json",
  "title":"Multiversal execution termination state",
  "type":"object",
  "additionalProperties":false,
  "required":["command_mode","work_item_status","successor_selection_required","successor_selected","requested_boundary_completed","active_async_operations","pending_authorized_steps","genuine_blocker"],
  "properties":{
    "command_mode":{"enum":["execution","status_and_continue","keep_going","get_ready","status_only","analysis_only"]},
    "work_item_status":{"type":"string","minLength":1},
    "successor_selection_required":{"type":"boolean"},
    "successor_selected":{"type":"boolean"},
    "requested_boundary_completed":{"type":"boolean"},
    "active_async_operations":{"type":"integer","minimum":0},
    "pending_authorized_steps":{"type":"array","items":{"type":"string"}},
    "pull_request_state":{"type":["string","null"],"enum":[null,"none","open","merged","closed_unmerged"]},
    "current_head_validation_state":{"type":["string","null"],"enum":[null,"none","queued","in_progress","failed","passed","superseded"]},
    "merge_closeout_pending":{"type":"boolean"},
    "execution_envelope":{
      "type":"object",
      "additionalProperties":false,
      "required":["cycle_id","phase","elapsed_active_minutes","closeout_switch_active_minute","target_cycle_minutes","safe_same_lane_work_available","dynamic_fill_attempted","closeout_complete","fill_exit_reason"],
      "properties":{
        "cycle_id":{"type":"string","minLength":1},
        "phase":{"enum":["fill","closeout","closed"]},
        "elapsed_active_minutes":{"type":"number","minimum":0},
        "closeout_switch_active_minute":{"const":16},
        "target_cycle_minutes":{"const":24},
        "safe_same_lane_work_available":{"type":"boolean"},
        "dynamic_fill_attempted":{"type":"boolean"},
        "closeout_complete":{"type":"boolean"},
        "fill_exit_reason":{"type":["string","null"],"enum":[null,"closeout_switch_reached","safe_work_exhausted"]}
      }
    },
    "genuine_blocker":{
      "oneOf":[
        {"type":"null"},
        {
          "type":"object",
          "additionalProperties":false,
          "required":["class","evidence","recovery_attempted","blocks_all_authorized_progress"],
          "properties":{
            "class":{"enum":["owner_only","environment_unavailable","source_unavailable","safety","irrecoverable_external"]},
            "evidence":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
            "recovery_attempted":{"const":true},
            "blocks_all_authorized_progress":{"const":true}
          }
        }
      ]
    }
  },
  "allOf":[
    {
      "if":{
        "properties":{
          "command_mode":{"enum":["execution","status_and_continue","keep_going"]},
          "work_item_status":{"const":"completed_verified"}
        },
        "required":["command_mode","work_item_status"]
      },
      "then":{"required":["execution_envelope"]}
    }
  ]
}
