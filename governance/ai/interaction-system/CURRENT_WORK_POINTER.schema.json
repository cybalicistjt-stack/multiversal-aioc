{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multiversal.local/schemas/current-work-pointer-1.0.0.schema.json",
  "title": "Multiversal Current Work Pointer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "updated_at",
    "canonical_bootstrap",
    "static_restart_prompt",
    "primary_attempt_id",
    "selection_reason",
    "active_attempts",
    "deferred_tracks"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "updated_at": {"type": "string", "format": "date-time"},
    "canonical_bootstrap": {"type": "string", "minLength": 1},
    "static_restart_prompt": {"type": "string", "minLength": 1},
    "primary_attempt_id": {"type": "string", "minLength": 1},
    "selection_reason": {"type": "string", "minLength": 1},
    "active_attempts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "work_item_id",
          "attempt_id",
          "track",
          "priority",
          "owner_selected",
          "repository",
          "branch",
          "checkpoint_path",
          "status",
          "updated_at",
          "roadmap_projection_pending"
        ],
        "properties": {
          "work_item_id": {"type": "string", "minLength": 1},
          "attempt_id": {"type": "string", "minLength": 1},
          "track": {"type": "string", "minLength": 1},
          "priority": {"type": "integer", "minimum": 1},
          "owner_selected": {"type": "boolean"},
          "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
          "branch": {"type": "string", "minLength": 1},
          "checkpoint_path": {"type": "string", "minLength": 1},
          "status": {
            "enum": [
              "started",
              "in_progress",
              "validation_failed",
              "blocked_non_owner",
              "blocked_owner",
              "ready_for_review",
              "completed_verified",
              "superseded"
            ]
          },
          "updated_at": {"type": "string", "format": "date-time"},
          "roadmap_projection_pending": {"type": "boolean"}
        }
      }
    },
    "deferred_tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["track", "next_work_item_id", "state", "reason", "evidence"],
        "properties": {
          "track": {"type": "string", "minLength": 1},
          "next_work_item_id": {"type": "string", "minLength": 1},
          "state": {"enum": ["planned", "paused", "blocked_owner", "blocked_dependency"]},
          "reason": {"type": "string", "minLength": 1},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
