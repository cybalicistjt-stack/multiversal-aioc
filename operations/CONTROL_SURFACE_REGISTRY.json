  "rule": "Only the canonical door, contract, current state, lane registry, and CURRENT-referenced work-item records may steer live work. CURRENT-referenced domain authorities may define current domain canon but cannot select work or expand scope. Every other surface is non-authoritative by construction.",
  "dispositions": {
    "CANONICAL_DOOR": "Only startup door.",
    "CANONICAL_CONTRACT": "Only global behavior contract.",
    "CANONICAL_STATE": "Only mutable current-state selector.",
    "CANONICAL_LANE_REGISTRY": "Only lane-routing map.",
    "CANONICAL_REFERENCED_WORK_ITEM": "Scope record authoritative only while referenced by CURRENT.json.",
    "REDIRECT": "May point to the canonical door but may not restate current state.",
    "GENERATED_COMPATIBILITY": "Projection for legacy tooling; source must be CURRENT.json and drift must be checkable.",
    "VALIDATION_ONLY": "May verify behavior/evidence but may not grant authority.",
    "EXECUTOR_ADAPTER": "Describes executor capability/configuration only.",
    "SOURCE_REFERENCE": "Source discovery/provenance or lane-local reference only.",
    "BACKGROUND_ONLY": "Product/history context only; never current state.",
    "HISTORICAL_INERT": "Preserved evidence/history or fail-closed compatibility stub; cannot steer live work.",
    "EXTERNAL_NONAUTHORITY": "External planning/business/service surface; never technical current-state authority.",
    "CURRENT_REFERENCED_DOMAIN_AUTHORITY": "Defines current canon for its domain only while named by CURRENT.json; cannot select work, expand scope, or grant implementation authority."
